<Window x:Class="RecipeControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RecipeControl"
        mc:Ignorable="d"
        Title="MainWindow" Height="550" Width="1000">
    <Grid>
        <Label
            Content="REG MICROINGREDIENTES" 
            HorizontalAlignment="Center" 
            Margin="0,5,0,0" 
            VerticalAlignment="Top" FontSize="21" FontWeight="Bold"/>
        <DataGrid x:Name="WeightRegisterDataGrid" 
            HorizontalAlignment="Center" 
            Height="268" 
            Margin="0,187,0,0" 
            VerticalAlignment="Top" 
            Width="960"
            AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Batch"
                    Binding="{Binding BatchRegistroId}"
                    Width="70"/>

                <DataGridTextColumn Header="Cod. Unico"
                    Binding="{Binding MacroRegistroId}"
                    Width="90"/>

                <DataGridTextColumn Header="Fecha QR"
                    Binding="{Binding Fecha, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                    Width="140"/>

                <DataGridTextColumn Header="Fecha Pistoleo"
                    Binding="{Binding FechaPistoleo, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                    Width="140"/>

                <DataGridTextColumn Header="Usuario"
                    Binding="{Binding UsuarioStr}"
                    Width="80"/>

                <DataGridTextColumn Header="Lote"
                    Binding="{Binding LoteStr}"
                    Width="70"/>

                <DataGridTextColumn Header="Nombre Macro"
                    Binding="{Binding NombreMacroIdStr}"
                    Width="120"/>

                <DataGridTextColumn Header="Peso SP (g)"
                    Binding="{Binding PesoObjStr, StringFormat={}{0:N2}}"
                    Width="90"/>

                <DataGridTextColumn Header="Peso Real (g)"
                    Binding="{Binding PesoRealStr, StringFormat={}{0:N2}}"
                    Width="90"/>

                <DataGridTextColumn Header="Ins1"
                    Binding="{Binding Insumo1Str}"
                    Width="60"/>

                <DataGridTextColumn Header="Ins2"
                    Binding="{Binding Insumo2Str}"
                    Width="60"/>

                <DataGridTextColumn Header="Ins3"
                    Binding="{Binding Insumo3Str}"
                    Width="60"/>

                <DataGridTextColumn Header="Ins4"
                    Binding="{Binding Insumo4Str}"
                    Width="60"/>
            </DataGrid.Columns>
        </DataGrid>
        <Label x:Name="LabelIDBatch" Content="1001" HorizontalAlignment="Left" Margin="872,7,0,0" VerticalAlignment="Top" Width="118" FontSize="22"/>
        <Label Content="Valor Pesado: Gramos" HorizontalAlignment="Left" Margin="20,45,0,0" VerticalAlignment="Top" FontSize="16" FontWeight="Bold"/>
        <Label Content="Codigo Unico:" HorizontalAlignment="Left" Margin="309,45,0,0" VerticalAlignment="Top" FontSize="16" FontWeight="Bold"/>
        <Label Content="Fecha Pesado:" HorizontalAlignment="Left" Margin="20,140,0,0" VerticalAlignment="Top" RenderTransformOrigin="1.968,0.461" FontSize="18" FontWeight="Bold"/>
        <Label Content="Tipo:" HorizontalAlignment="Left" Margin="360,140,0,0" VerticalAlignment="Top" RenderTransformOrigin="1.968,0.461" FontSize="18" FontWeight="Bold"/>
        <Label Content="Lote:" HorizontalAlignment="Left" Margin="520,140,0,0" VerticalAlignment="Top" RenderTransformOrigin="1.968,0.461" FontSize="18" FontWeight="Bold"/>
        <Label x:Name="LabelValPesado" Content="####,##" HorizontalAlignment="Left" Margin="14,64,0,0" VerticalAlignment="Top" FontSize="48" Foreground="#FF0430E4" FontWeight="Bold"/>
        <Label x:Name="LabelCodUnico" Content="#########" HorizontalAlignment="Left" Margin="234,64,0,0" VerticalAlignment="Top" FontSize="48" FontWeight="Bold"/>
        <Label x:Name="LabelFechaPesado" Content="Fecha Pesado:" HorizontalAlignment="Left" Margin="149,140,0,0" VerticalAlignment="Top" RenderTransformOrigin="1.968,0.461" FontSize="18" FontWeight="Bold"/>
        <Label x:Name="LabelTipo" Content="Tipo:" HorizontalAlignment="Left" Margin="413,140,0,0" VerticalAlignment="Top" RenderTransformOrigin="1.968,0.461" FontSize="18" FontWeight="Bold"/>
        <Label x:Name="LabelLote" Content="Lote:" HorizontalAlignment="Left" Margin="577,140,0,0" VerticalAlignment="Top" RenderTransformOrigin="1.968,0.461" FontSize="18" FontWeight="Bold"/>
        <Label Content="BATCH:" HorizontalAlignment="Left" Margin="787,7,0,0" VerticalAlignment="Top" RenderTransformOrigin="1.968,0.461" FontSize="22" FontWeight="Bold"/>
        <Button x:Name="BotonConfig" Content="Configuracion" HorizontalAlignment="Left" Margin="33,475,0,0" VerticalAlignment="Top" Width="117" Height="24" Click="BotonConfig_Click" Background="#FFF3F0F0"/>
    </Grid>
</Window>
