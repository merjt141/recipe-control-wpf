<Window x:Class="ReportMicro.Views.ReportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ReportMicro.Views"
        mc:Ignorable="d"
        Title="ReportView" Height="450" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <DatePicker x:Name="FechaInicial" HorizontalAlignment="Left" Height="25" Margin="38,80,0,0" VerticalAlignment="Top" Width="166"/>
        <DatePicker x:Name="FechaFinal" HorizontalAlignment="Left" Height="25" Margin="234,80,0,0" VerticalAlignment="Top" Width="166"/>
        <Label Content="Generar Reporte de Consumos - Micro Ingredientes Frima" HorizontalAlignment="Center" Height="45" Margin="0,10,0,0" VerticalAlignment="Top" Width="610" FontSize="21" FontWeight="Bold" HorizontalContentAlignment="Center"/>
        <Label Content="Fecha Inicial" HorizontalAlignment="Left" Height="20" Margin="38,55,0,0" VerticalAlignment="Top" Width="143" FontWeight="Bold" VerticalContentAlignment="Center" Padding="0"/>
        <Label Content="Fecha Final" HorizontalAlignment="Left" Height="20" Margin="234,55,0,0" VerticalAlignment="Top" Width="143" FontWeight="Bold" VerticalContentAlignment="Center" Padding="0"/>
        <Button x:Name="BotonActualizar" Content="Actualizar" HorizontalAlignment="Left" Height="25" Margin="436,80,0,0" VerticalAlignment="Top" Width="97" Click="BotonActualizar_Click_1"/>
        <Button x:Name="BotonReporte" Content="Generar Reporte en C:\Reportes" HorizontalAlignment="Left" Height="25" Margin="388,380,0,0" VerticalAlignment="Top" Width="256" Click="BotonReporte_Click"/>
        <DataGrid x:Name="ReportDataGrid2" HorizontalAlignment="Center" Height="227" Margin="0,131,0,0" VerticalAlignment="Top" Width="960"
            AutoGenerateColumns="False" SelectionChanged="ReportDataGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Batch"
                 Binding="{Binding BatchRegistroId}"
                 Width="70"/>

                <DataGridTextColumn Header="Cod. Unico"
                 Binding="{Binding MacroRegistroId}"
                 Width="90"/>

                <DataGridTextColumn Header="Fecha QR"
                 Binding="{Binding Fecha, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                 Width="140"/>

                <DataGridTextColumn Header="Fecha Pistoleo"
                 Binding="{Binding FechaPistoleo, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                 Width="140"/>

                <DataGridTextColumn Header="Usuario"
                 Binding="{Binding UsuarioStr}"
                 Width="80"/>

                <DataGridTextColumn Header="Lote"
                 Binding="{Binding LoteStr}"
                 Width="70"/>

                <DataGridTextColumn Header="Peso SP (g)"
                Binding="{Binding PesoObj, StringFormat={}{0:N2}}"
                Width="90"/>

                <DataGridTextColumn Header="Peso Real (g)"
                Binding="{Binding PesoReal, StringFormat={}{0:N2}}"
                Width="90"/>

                <DataGridTextColumn Header="Ins1"
                 Binding="{Binding Insumo1StrSAP}"
                 Width="60"/>

                <DataGridTextColumn Header="Ins2"
                 Binding="{Binding Insumo2StrSAP}"
                 Width="60"/>

                <DataGridTextColumn Header="Ins3"
                 Binding="{Binding Insumo3StrSAP}"
                 Width="60"/>

                <DataGridTextColumn Header="Ins4"
                 Binding="{Binding Insumo4StrSAP}"
                 Width="60"/>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Window>
