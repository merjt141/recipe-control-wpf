<Window x:Class="RecipeControl.Views.RegisterModuleView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Registro de Pesos de Balanza" 
        Height="850" 
        Width="1500"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        ResizeMode="CanMinimize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="0">
        <!-- ============================
             TITULO + USUARIO
        ============================= -->
        <Label
            Content="PESAJE MICROINGREDIENTES" HorizontalAlignment="Center" VerticalAlignment="Top" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" 
            Margin="0,10,0,0"
            FontSize="25"
            FontWeight="Bold"
            Height="40" Width="380"/>

        <Label x:Name="UserLbl"
               Content="Usuario" HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
               Margin="1250,10,0,0" 
               FontSize="14"
               Height="40" Width="60"/>

        <TextBox x:Name="UserInput" HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Margin="1310,20,0,0" 
                TextWrapping="Wrap"
                FontSize="14"
                IsReadOnlyCaretVisible="True"
                Height="20" Width="140" Text="op"/>


        <!-- ============================
             CANTIDAD DE BOLSAS
        ============================= -->

        <!-- ============================
             DATOS DE BOLSA
        ============================= -->

        <GroupBox Header="Datos de la bolsa"
                  VerticalAlignment="Top"
                  Margin="30,56,609,0"
                  FontSize="28" FontWeight="Bold"
                  BorderBrush="Gray"
                  BorderThickness="1"
                  Height="554">
            <Grid Height="478" Margin="10,0,17,0">

                <Label x:Name="DatetimeLbl"
               Content="Fecha Pesado" HorizontalAlignment="Left" VerticalAlignment="Top" VerticalContentAlignment="Center" 
               Margin="22,4,0,0"
               FontSize="22"
               FontWeight="Bold"
               Height="40" Width="148"/>

                <TextBox x:Name="DatetimeInput"
                 HorizontalAlignment="Left" VerticalAlignment="Top" VerticalContentAlignment="Center"
                 Margin="20,44,0,0" Padding="0,-12,0,0"
                 TextWrapping="Wrap"
                 FontSize="62"
                 IsReadOnly="True"
                 Background="#FFCFF6FB"
                 Height="62" Width="692"/>

                <Label x:Name="UnicodeLbl"
               Content="Código Único" HorizontalAlignment="Left" VerticalAlignment="Top" VerticalContentAlignment="Center"
               Margin="22,111,0,0"               
               FontSize="22"
               FontWeight="Bold"
               Height="40" Width="150"/>

                <TextBox x:Name="UnicodeInput"
                 HorizontalAlignment="Left" VerticalAlignment="Top" VerticalContentAlignment="Center"
                 Margin="20,150,0,0" Padding="0,-12,0,0"
                 TextWrapping="Wrap"
                 FontSize="62"
                 IsReadOnly="True"
                 Background="#FFC4F5FB"
                 Height="64" Width="480"/>
                <Label x:Name="WeighLbl" 
               Content="Valor Pesado:" HorizontalAlignment="Left" VerticalAlignment="Top" VerticalContentAlignment="Center"
               Margin="22,222,0,0"
               FontSize="22"
               FontWeight="Bold"
               Height="40" Width="148"/>
                <TextBox x:Name="WeighInput"
                 HorizontalAlignment="Left" VerticalAlignment="Top" VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
                 Margin="20,267,0,0" Padding="0,-12,0,0"
                 TextWrapping="Wrap" 
                 FontSize="62" Text="480.5"
                 FontWeight="Bold"
                 Foreground="#FF0D48A9" Background="#FFCCF5FF"
                 IsReadOnly="True"
                 Height="80" Width="274"/>
                <TextBox x:Name="WeigUnid"
                 HorizontalAlignment="Left" VerticalAlignment="Top" VerticalContentAlignment="Center"
                 Margin="297,267,0,0" Padding="0,-12,0,0"
                 TextWrapping="Wrap" 
                 FontSize="62"
                 FontWeight="Bold" 
                 Foreground="#FF0D48A9" Background="#FFCCF5FF"
                 IsReadOnly="True"
                 Text="g"
                 Height="80" Width="48"/>
                <Button x:Name="PesarBtn" Content="Pesar(1)" HorizontalAlignment="Left" Margin="661,272,0,0" VerticalAlignment="Top" Height="70" Width="143" FontSize="36" Click="Button_Click"/>
                <Button x:Name="QRPrintBtn" Content="QR(2)" HorizontalAlignment="Left" Margin="672,398,0,0" VerticalAlignment="Top" Height="70" Width="119" FontSize="36" Click="Button2_Click"/>
                <TextBox x:Name="LoteInsumoInput"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="20,398,0,0" Padding="0,-12,0,0"
                 TextWrapping="Wrap"
                 FontSize="62" Text="100000001"
                 Height="70" Width="549" RenderTransformOrigin="0.519,0.575"/>
                <Label x:Name="UnicodeLbl_Copiar"
                    Content="Lote:" HorizontalAlignment="Left" VerticalAlignment="Top" VerticalContentAlignment="Center"
                    Margin="22,358,0,0"               
                    FontSize="22"
                    FontWeight="Bold"
                    Height="40" Width="150"/>
                <Label x:Name="UnicodeLbl_Copiar1"
                    Content="Peso Obj:" HorizontalAlignment="Left" VerticalAlignment="Top" VerticalContentAlignment="Center"
                    Margin="464,222,0,0"               
                    FontSize="22"
                    FontWeight="Bold"
                    Height="40" Width="150"/>
                <Label x:Name="PesoObjLbl"

                    Grid.Column="0"
                    Content="0.0"
                    FontSize="62"
                    FontWeight="Bold"
                    HorizontalContentAlignment="Right"
                    VerticalContentAlignment="Center" Margin="366,256,235,136"/>

                <Label x:Name="UndObjLbl"
                    Content="g" HorizontalAlignment="Left" VerticalAlignment="Top" VerticalContentAlignment="Center"
                    Margin="586,253,0,0"               
                    FontSize="62"
                    FontWeight="Bold"
                    Height="94" Width="43"/>

            </Grid>
        </GroupBox>


        <!-- ============================
             PESADO DE INSUMOS
        ============================= -->

        <GroupBox Header="Insumos"
                  VerticalAlignment="Top"
                  Margin="914,56,10,0"
                  FontSize="28" FontWeight="Bold"
                  BorderBrush="Gray"
                  BorderThickness="1"
                  Height="550">
            <Grid Height="498" Margin="41,0,13,0">

                <Label x:Name="SAPCodeLbl" 
               Content=" Insumo1" HorizontalAlignment="Left" VerticalAlignment="Top" VerticalContentAlignment="Center"
               Margin="10,126,0,0" 
               FontSize="22"
               FontWeight="Bold"
               Height="40" Width="119"/>

                <ComboBox x:Name="SAPCodeCmb"
                  HorizontalAlignment="Left" VerticalAlignment="Top" VerticalContentAlignment="Center"
                  Margin="134,110,0,0"
                  FontSize="48"
                  Height="80" Width="360"
                  DisplayMemberPath="Codigo"
                  SelectedValuePath="Id"
                  SelectionChanged="SAPCodeCmb_SelectionChanged">
                    <ComboBox.Background>
                        <LinearGradientBrush EndPoint="0,1">
                            <GradientStop Color="#FFF0F0F0"/>
                            <GradientStop Color="#FFE5E5E5" Offset="1"/>
                        </LinearGradientBrush>
                    </ComboBox.Background>
                </ComboBox>
                <ComboBox x:Name="SAPCodeCmb2"
                    HorizontalAlignment="Left" VerticalAlignment="Top" VerticalContentAlignment="Center"
                    Margin="134,210,0,0"
                    FontSize="48"
                    Height="80" Width="360"
                    DisplayMemberPath="Codigo"
                    SelectedValuePath="Id"
                    SelectionChanged="SAPCodeCmb2_SelectionChanged">
                    <ComboBox.Background>
                        <LinearGradientBrush EndPoint="0,1">
                            <GradientStop Color="#FFF0F0F0"/>
                            <GradientStop Color="#FFE5E5E5" Offset="1"/>
                        </LinearGradientBrush>
                    </ComboBox.Background>
                </ComboBox>
                <ComboBox x:Name="SAPCodeCmb3"
                    HorizontalAlignment="Left" VerticalAlignment="Top" VerticalContentAlignment="Center"
                    Margin="134,306,0,0"
                    FontSize="48"
                    Height="80" Width="360"
                    DisplayMemberPath="Codigo"
                    SelectedValuePath="Id"
                    SelectionChanged="SAPCodeCmb3_SelectionChanged">
                    <ComboBox.Background>
                        <LinearGradientBrush EndPoint="0,1">
                            <GradientStop Color="#FFF0F0F0"/>
                            <GradientStop Color="#FFE5E5E5" Offset="1"/>
                        </LinearGradientBrush>
                    </ComboBox.Background>
                </ComboBox>
                <ComboBox x:Name="SAPCodeCmb4"
                    HorizontalAlignment="Left" VerticalAlignment="Top" VerticalContentAlignment="Center"
                    Margin="134,408,0,0"
                    FontSize="48"
                    Height="80" Width="360"
                    DisplayMemberPath="Codigo"
                    SelectedValuePath="Id"
                    SelectionChanged="SAPCodeCmb4_SelectionChanged">
                    <ComboBox.Background>
                        <LinearGradientBrush EndPoint="0,1">
                            <GradientStop Color="#FFF0F0F0"/>
                            <GradientStop Color="#FFE5E5E5" Offset="1"/>
                        </LinearGradientBrush>
                    </ComboBox.Background>
                </ComboBox>
                <Label x:Name="SAPCodeLbl_Copiar" 
                    Content=" Insumo4" HorizontalAlignment="Left" VerticalAlignment="Top" VerticalContentAlignment="Center"
                    Margin="11,428,0,0" 
                    FontSize="22"
                    FontWeight="Bold"
                    Height="40" Width="119"/>
                <ComboBox x:Name="ProdNomCodeCmb"
                    HorizontalAlignment="Left" VerticalAlignment="Top" VerticalContentAlignment="Center"
                    Margin="134,10,0,0"
                    FontSize="48"
                    Height="80" Width="360"
                    DisplayMemberPath="Codigo"
                    SelectedValuePath="Id"
                    SelectionChanged="ProdNomCodeCmb_SelectionChanged">
                    <ComboBox.Background>
                        <LinearGradientBrush EndPoint="0,1">
                            <GradientStop Color="#FFF0F0F0"/>
                            <GradientStop Color="#FFE5E5E5" Offset="1"/>
                        </LinearGradientBrush>
                    </ComboBox.Background>
                </ComboBox>
                <Label x:Name="SAPCodeLbl_Copiar1" 
                    Content="Producto" HorizontalAlignment="Left" VerticalAlignment="Top" VerticalContentAlignment="Center"
                    Margin="15,30,0,0" 
                    FontSize="22"
                    FontWeight="Bold"
                    Height="40" Width="119" RenderTransformOrigin="0.494,-1.724" Foreground="#FF062DA7"/>
                <Label x:Name="SAPCodeLbl_Copiar2" 
                    Content=" Insumo2" HorizontalAlignment="Left" VerticalAlignment="Top" VerticalContentAlignment="Center"
                    Margin="10,224,0,0" 
                    FontSize="22"
                    FontWeight="Bold"
                    Height="40" Width="119"/>
                <Label x:Name="SAPCodeLbl_Copiar3" 
                    Content=" Insumo3" HorizontalAlignment="Left" VerticalAlignment="Top" VerticalContentAlignment="Center"
                    Margin="10,326,0,0" 
                    FontSize="22"
                    FontWeight="Bold"
                    Height="40" Width="119"/>

            </Grid>
        </GroupBox>




        <!-- ============================
             NOTIFICACIONES
        ============================= -->

        <GroupBox Header="Descripción de Eventos:"
                  VerticalAlignment="Top"
                  Margin="30,615,10,0"
                  FontSize="28" FontWeight="Bold"
                  BorderBrush="Gray"
                  BorderThickness="1"
                  Height="170">
            <Grid>

                <TextBlock x:Name="LabelMsgPesaje" 
               Text="Mensajes" VerticalAlignment="Top"
               TextWrapping="Wrap"
               Margin="10,10,10,0" 
                            FontSize="18" FontWeight="Normal"
               RenderTransformOrigin="0.386,-0.057" 
               Height="70"/>

                <Button x:Name="BotonConfig" 
                Content="Configuración" HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="10,80,0,0"
                FontSize="20"
                Click="BotonConfig_Click" 
                Height="40" Width="160"/>

            </Grid>
        </GroupBox>

    </Grid>
</Window>
